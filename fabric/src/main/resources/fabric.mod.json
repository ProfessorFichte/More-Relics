{
	"schemaVersion": 1,
	"id": "more_relics",
	"version": "${version}",
	"name": "More Relics",
	"description": "This is a Relics (RPG-Series) Add-On, adding relics for the More RPG Classes and powerful relics!",
	"authors": [
		"Fichte"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "ARR",
	"icon": "assets/more_relics/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"com.more_relics.fabric.client.FabricClientMod"
		],
		"main": [
			"com.more_relics.fabric.FabricMod"
		],
		"fabric-datagen": [
			"more_relics.MoreRelicsDataGenerator"
		]
	},
	"mixins": [
		"more-relics.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_compat_version}",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"spell_engine": ">=${spell_engine_version}",
		"relics_rpgs": ">=${relics_version}"
	}
}